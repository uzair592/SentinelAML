# Local-only development defaults. Never commit real credentials.
SENTINELAML_ENV=development
SENTINELAML_CORS_ORIGINS=http://127.0.0.1:5173
SENTINELAML_MAX_UPLOAD_MB=20
SENTINELAML_MAX_ANALYSIS_ROWS=200000
SENTINELAML_SQL_ROW_LIMIT=5000

# Add exact, administrator-approved database hostnames for SQL sources.
# Example only: SENTINELAML_ALLOWED_DB_HOSTS=dev-db.example.internal
# Localhost is allowed only in development. Do not use wildcards in production.
SENTINELAML_ALLOWED_DB_HOSTS=

# SQLite file sources are restricted to this directory.
SENTINELAML_SQLITE_ROOT=./source-databases

# Persistent metadata database (local SQLite default; PostgreSQL URL for approved deployment)
SENTINELAML_DB_PATH=./sentinelaml.db
# SENTINELAML_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@APP_DB_HOST:5432/sentinelaml
SENTINELAML_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
SENTINELAML_ADMIN_EMAIL=sentinel.admin@example.com
SENTINELAML_ADMIN_PASSWORD=ChangeThis-LocalOnly-123!

# Optional external model. OFF by default. Only enable after institutional approval.
SENTINELAML_LLM_PROVIDER=none
SENTINELAML_LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
SENTINELAML_POLICY_MAX_UPLOAD_MB=10
