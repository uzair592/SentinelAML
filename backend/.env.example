# Local-only development defaults. Never commit real credentials.
SENTINELAML_ENV=development
SENTINELAML_CORS_ORIGINS=http://localhost:5173
SENTINELAML_MAX_UPLOAD_MB=20
SENTINELAML_MAX_ANALYSIS_ROWS=200000
SENTINELAML_SQL_ROW_LIMIT=5000

# Add exact, administrator-approved database hostnames for SQL sources.
# Example only: SENTINELAML_ALLOWED_DB_HOSTS=dev-db.example.internal
# Localhost is allowed only in development. Do not use wildcards in production.
SENTINELAML_ALLOWED_DB_HOSTS=

# SQLite file sources are restricted to this directory.
SENTINELAML_SQLITE_ROOT=./source-databases
